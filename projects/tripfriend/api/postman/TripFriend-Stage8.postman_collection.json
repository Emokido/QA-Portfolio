        {
          "name": "TF-S8-POSTMAN-006 reviewId null 입력 검증",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const accessToken = pm.environment.get(\"accessToken\");",
                  "if (!accessToken) {",
                  "    throw new Error(\"사전조건 실패: 로컬 테스트 로그인 후 accessToken이 필요합니다.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"reviewId null은 HTTP 400으로 종료된다\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"인증 오류 401·403으로 가려지지 않는다\", function () {",
                  "    pm.expect(pm.response.code).to.not.be.oneOf([401, 403]);",
                  "});",
                  "",
                  "pm.test(\"통제된 JSON 오류 본문이 반환된다\", function () {",
                  "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
                  "    pm.expect(contentType).to.include(\"application/json\");",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"code\");",
                  "    pm.expect(body.code).to.not.eql(\"201-1\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json", "type": "text"},
              {"key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Stage8 null 리뷰 식별자\",\n  \"reviewId\": null\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "comments"]
            },
            "description": "TF-TC-043-B·TF-BUG-006 실제 서버 확인. 유효한 Bearer 인증을 사전조건으로 reviewId null이 HTTP 400과 통제된 JSON 오류 본문으로 종료되는지 확인한다. 401·403이나 빈 본문은 입력 검증 성공으로 처리하지 않는다."
          },
