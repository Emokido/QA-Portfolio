    {
      "name": "04 Validation & Security",
      "description": "JUnit의 모든 경계를 중복하지 않고 비로그인 차단과 reviewId null의 대표 입력 검증을 실제 HTTP로 확인한다.",
      "item": [
        {
          "name": "TF-S8-POSTMAN-005 비로그인 댓글 생성 차단",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"인증 없는 댓글 생성은 HTTP 401로 차단된다\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test(\"성공 코드 201-1이 반환되지 않는다\", function () {",
                  "    pm.expect(pm.response.text()).to.not.include(\"201-1\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json", "type": "text"}
            ],
            "body": {
              "mode": "raw",
